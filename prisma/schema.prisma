generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  email              String?           @unique(map: "users_email_unique")
  username           String?           @unique(map: "users_username_unique")
  passwordHash       String?           @map("password_hash")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  firstName          String?           @map("first_name")
  lastName           String?           @map("last_name")
  profileImageUrl    String?           @map("profile_image_url")
  bio                String?
  instagramHandle    String?           @unique @map("instagram_handle")
  isVerified         Boolean           @default(false) @map("is_verified")
  location           String?
  website            String?
  avatarEmoji        String?           @map("avatar_emoji")
  instagramId        String?           @unique @map("instagram_id")
  instagramPostCount Int               @default(0) @map("instagram_post_count")
  isInstagramImport  Boolean           @default(false) @map("is_instagram_import")
  lastInstagramSync  DateTime?         @map("last_instagram_sync") @db.Timestamp(6)
  activities         Activity[]
  conversations      Conversation[]
  following          Follow[]          @relation("follower")
  followers          Follow[]          @relation("following")
  lists              List[]
  photos             Photo[]
  reviews            Review[]
  savedPlaces        SavedPlace[]
  sources            Source[]

  @@map("users")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model Place {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  googlePlaceId    String             @unique(map: "places_google_place_id_unique") @map("google_place_id")
  name             String
  formattedAddress String             @map("formatted_address")
  neighborhood     String?
  locality         String?
  lat              Float              @db.Real
  lng              Float              @db.Real
  primaryType      String?            @map("primary_type")
  types            Json?
  priceLevel       String?            @map("price_level")
  photoRefs        Json?              @map("photo_refs")
  aiSummary        String?            @map("ai_summary")
  aiSummaryUpdatedAt DateTime?        @map("ai_summary_updated_at") @db.Timestamp(6)
  topChips         Json?              @map("top_chips")
  /// Up to 3 dish names creators single out (Aggregate, then Summarize).
  knownFor         Json?              @map("known_for")
  /// { loved, liked, mixed, disliked } across the place's mentions.
  verdictCounts    Json?              @map("verdict_counts")
  /// A = name, B = tags + synonyms + known-for, C = latest excerpts, D = area.
  searchDocument   Unsupported("tsvector")? @map("search_document")
  isHidden         Boolean            @default(false) @map("is_hidden")
  mergedIntoId     String?            @map("merged_into_id") @db.VarChar(36)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  activities       Activity[]
  engineRuns       EngineRun[]
  listPlaces       ListPlace[]
  photos           Photo[]
  placeTags        PlaceTag[]
  placeTagAggregates PlaceTagAggregate[]
  reviews          Review[]
  savedPlaces      SavedPlace[]

  @@index([searchDocument], type: Gin)
  @@map("places")
}

model SavedPlace {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  placeId   String    @map("place_id") @db.VarChar(36)
  visitedAt DateTime? @map("visited_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  hasBeen   Boolean?  @default(false) @map("has_been")
  rating    Int?
  emoji     String?
  place     Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@map("saved_places")
}

model List {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  userId      String          @map("user_id") @db.VarChar(36)
  name        String
  description String?
  visibility  list_visibility @default(PRIVATE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  isSystem    Boolean?        @default(false) @map("is_system")
  systemSlug  String?         @map("system_slug") @db.VarChar(255)
  activities  Activity[]
  listPlaces  ListPlace[]
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lists")
}

model ListPlace {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  listId    String   @map("list_id") @db.VarChar(36)
  placeId   String   @map("place_id") @db.VarChar(36)
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamp(6)
  note      String?
  sortOrder Int?     @map("sort_order")
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([listId, placeId])
  @@map("list_places")
}

model Follow {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  followerId  String   @map("follower_id") @db.VarChar(36)
  followingId String   @map("following_id") @db.VarChar(36)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Activity {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  actorId   String        @map("actor_id") @db.VarChar(36)
  type      activity_type
  placeId   String?       @map("place_id") @db.VarChar(36)
  listId    String?       @map("list_id") @db.VarChar(36)
  metadata  Json?
  dedupeKey String        @unique @map("dedupe_key")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  actor     User          @relation(fields: [actorId], references: [id], onDelete: Cascade)
  list      List?         @relation(fields: [listId], references: [id])
  place     Place?        @relation(fields: [placeId], references: [id])

  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("activities")
}

model Review {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  userId             String        @map("user_id") @db.VarChar(36)
  placeId            String        @map("place_id") @db.VarChar(36)
  rating             Int?
  note               String?
  visitedAt          DateTime?     @map("visited_at") @db.Timestamp(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  instagramEmbedHtml String?       @map("instagram_embed_html")
  instagramPostId    String?       @map("instagram_post_id")
  instagramShortcode String?       @map("instagram_shortcode")
  instagramUrl       String?       @map("instagram_url")
  source             review_source @default(manual)
  socialPostCaption     String?    @map("social_post_caption")
  socialPostMediaUrl    String?    @map("social_post_media_url")
  socialPostMediaType   String?    @map("social_post_media_type")
  socialPostLikes       Int?       @map("social_post_likes")
  socialPostPostedAt    DateTime?  @map("social_post_posted_at") @db.Timestamp(6)
  /// The post this mention came from (engine mentions and backfilled imports).
  ingestedPostId     String?          @map("ingested_post_id") @db.VarChar(36)
  /// The creator's words about this place, verbatim from the caption.
  excerpt            String?
  /// [{ name, sentiment }]
  dishes             Json?
  verdict            mention_verdict?
  creatorScore       Float?           @map("creator_score")
  creatorScoreMax    Float?           @map("creator_score_max")
  role               mention_role?
  confidence         Float?
  status             mention_status?
  resolvedBy         resolved_by?     @map("resolved_by")
  isSponsored        Boolean?         @map("is_sponsored")
  photos             Photo[]
  reviewTags         ReviewTag[]
  ingestedPosts      IngestedPost[] @relation("LegacyPostReview")
  ingestedPost       IngestedPost?  @relation("PostMentions", fields: [ingestedPostId], references: [id], onDelete: SetNull)
  reviewItems        ReviewItem[]
  place              Place         @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instagramPostId, placeId])
  @@index([ingestedPostId])
  @@index([placeId])
  @@index([instagramPostId])
  @@index([source])
  @@map("reviews")
}

model Photo {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  userId           String   @map("user_id") @db.VarChar(36)
  placeId          String   @map("place_id") @db.VarChar(36)
  reviewId         String?  @map("review_id") @db.VarChar(36)
  url              String
  width            Int?
  height           Int?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  carouselPosition Int      @default(0) @map("carousel_position")
  isCarousel       Boolean  @default(false) @map("is_carousel")
  place            Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  review           Review?  @relation(fields: [reviewId], references: [id])
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([placeId, createdAt(sort: Desc)])
  @@index([reviewId, carouselPosition])
  @@map("photos")
}

model ImportJob {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  platform        import_platform
  type            import_type
  input           String
  maxPosts        Int             @default(100) @map("max_posts")
  status          job_status      @default(pending)
  postsFetched    Int             @default(0) @map("posts_fetched")
  postsProcessed  Int             @default(0) @map("posts_processed")
  reviewsCreated  Int             @default(0) @map("reviews_created")
  postsUnresolved Int             @default(0) @map("posts_unresolved")
  postsFailed     Int             @default(0) @map("posts_failed")
  error           String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  startedAt       DateTime?       @map("started_at") @db.Timestamp(6)
  completedAt     DateTime?       @map("completed_at") @db.Timestamp(6)
  sourceId        String?         @map("source_id") @db.VarChar(36)
  apifyRunId      String?         @map("apify_run_id")
  /// Only posts newer than this were requested (incremental sync).
  since           DateTime?       @db.Timestamp(6)
  ingestedPosts   IngestedPost[]
  source          Source?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([sourceId, createdAt(sort: Desc)])
  @@index([platform, status, createdAt])
  @@map("import_jobs")
}

model IngestedPost {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  platform             import_platform
  importJobId          String          @map("import_job_id") @db.VarChar(36)
  canonicalPostId      String          @map("canonical_post_id")
  url                  String
  authorHandle         String          @map("author_handle")
  authorPlatformId     String?         @map("author_platform_id")
  caption              String?
  postedAt             DateTime?       @map("posted_at") @db.Timestamp(6)
  likeCount            Int?            @map("like_count")
  media                Json?
  rawPayload           Json?           @map("raw_payload")
  resolvedGooglePlaceId String?        @map("resolved_google_place_id")
  resolveMethod        resolve_method? @map("resolve_method")
  resolveConfidence    Float?          @map("resolve_confidence")
  resolveCandidates    Json?           @map("resolve_candidates")
  reviewId             String?         @map("review_id") @db.VarChar(36)
  status               post_status     @default(new)
  error                String?
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  sourceId             String?         @map("source_id") @db.VarChar(36)
  postType             post_type?      @map("post_type")
  isPlaceContent       Boolean?        @map("is_place_content")
  isSponsored          Boolean?        @map("is_sponsored")
  lastRunId            String?         @map("last_run_id") @db.VarChar(36)
  importJob            ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  review               Review?         @relation("LegacyPostReview", fields: [reviewId], references: [id])
  source               Source?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  mentions             Review[]        @relation("PostMentions")
  runs                 EngineRun[]
  reviewItems          ReviewItem[]

  @@index([sourceId, postedAt(sort: Desc)])
  @@unique([platform, canonicalPostId])
  @@index([status])
  @@index([authorHandle])
  @@index([resolvedGooglePlaceId])
  @@map("ingested_posts")
}

model Job {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  type      job_type
  payload   Json
  status    job_status @default(queued)
  attempts  Int        @default(0)
  runAfter  DateTime   @default(now()) @map("run_after") @db.Timestamp(6)
  error     String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([status, runAfter])
  @@index([type, status])
  @@map("jobs")
}

model ReviewTag {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  reviewId   String     @map("review_id") @db.VarChar(36)
  tagId      String     @map("tag_id") @db.VarChar(36)
  source     tag_source @default(ai)
  confidence Float
  /// The line in the mention that supports the tag.
  evidence   String?
  runId      String?    @map("run_id") @db.VarChar(36)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  review     Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([reviewId, tagId])
  @@index([reviewId])
  @@index([tagId])
  @@map("review_tags")
}

model PlaceTagAggregate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  placeId         String   @map("place_id") @db.VarChar(36)
  tagId           String   @map("tag_id") @db.VarChar(36)
  confidence      Float
  evidenceCount   Int      @default(0) @map("evidence_count")
  evidenceScore   Float    @default(0) @map("evidence_score")
  lastComputedAt  DateTime @default(now()) @map("last_computed_at") @db.Timestamp(6)
  isSuppressed    Boolean  @default(false) @map("is_suppressed")
  sourceBreakdown Json?    @map("source_breakdown")
  place           Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  tag             Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([placeId, tagId])
  @@index([placeId, confidence])
  @@map("place_tag_aggregates")
}

model Conversation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  title     String    @default("New Chat")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  /// Full AI SDK UIMessage[] for the agent chat (text, reasoning, tool calls,
  /// sources). Written in /api/chat onFinish.
  uiMessages Json?    @map("ui_messages")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("conversations")
}

model TagCategory {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  slug         String  @unique
  displayName  String  @map("display_name")
  description  String?
  searchWeight Float   @default(1.0) @map("search_weight")
  sortOrder    Int     @default(0) @map("sort_order")
  iconName     String? @map("icon_name")
  tags         Tag[]

  @@map("tag_categories")
}

model Tag {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  categoryId        String              @map("category_id") @db.VarChar(36)
  slug              String              @unique
  displayName       String              @map("display_name")
  description       String?
  iconName          String?             @map("icon_name")
  sortOrder         Int                 @default(0) @map("sort_order")
  /// Other words for the tag: search matches them, the Tag agent reads them.
  synonyms          String[]            @default([])
  status            tag_status          @default(active)
  mergedIntoId      String?             @map("merged_into_id") @db.VarChar(36)
  category          TagCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  placeTags         PlaceTag[]
  reviewTags        ReviewTag[]
  placeTagAggregates PlaceTagAggregate[]

  @@index([categoryId])
  @@map("tags")
}

model PlaceTag {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  placeId    String     @map("place_id") @db.VarChar(36)
  tagId      String     @map("tag_id") @db.VarChar(36)
  source     tag_source @default(manual)
  confidence Float?
  addedById  String?    @map("added_by_id") @db.VarChar(36)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  place      Place      @relation(fields: [placeId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([placeId, tagId])
  @@index([placeId])
  @@index([tagId])
  @@map("place_tags")
}

/// A creator account the engine follows (today: an Instagram handle).
model Source {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  platform     import_platform @default(instagram)
  handle       String
  /// The creator's User.
  userId       String?         @map("user_id") @db.VarChar(36)
  status       source_status   @default(active)
  homeCity     String?         @map("home_city")
  /// Notes the Read agent gets with every post (e.g. the creator's rating scale).
  notes        String?
  trustWeight  Float           @default(1.0) @map("trust_weight")
  lastSyncedAt DateTime?       @map("last_synced_at") @db.Timestamp(6)
  lastPostAt   DateTime?       @map("last_post_at") @db.Timestamp(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  syncs        ImportJob[]
  posts        IngestedPost[]

  @@unique([platform, handle])
  @@map("sources")
}

/// One execution of the pipeline: for a post (stages read → tag) or a place
/// (aggregate, summarize). Status is derived from its steps.
model EngineRun {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  kind        engine_run_kind   @default(post)
  postId      String?           @map("post_id") @db.VarChar(36)
  placeId     String?           @map("place_id") @db.VarChar(36)
  /// ingest, reprocess, rerun, backfill, place_changed
  trigger     String
  /// Earlier stages reuse the last run's stored output.
  fromStage   String?           @map("from_stage")
  requestedBy String?           @map("requested_by")
  status      engine_run_status @default(queued)
  costUsd     Float             @default(0) @map("cost_usd")
  error       String?
  startedAt   DateTime          @default(now()) @map("started_at") @db.Timestamp(6)
  finishedAt  DateTime?         @map("finished_at") @db.Timestamp(6)
  post        IngestedPost?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  place       Place?            @relation(fields: [placeId], references: [id], onDelete: Cascade)
  steps       EngineStep[]

  @@index([postId, startedAt(sort: Desc)])
  @@index([placeId, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@map("engine_runs")
}

/// One stage of a run, with what went in, what came out, and what it cost.
model EngineStep {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  runId          String             @map("run_id") @db.VarChar(36)
  /// sync, media, read, resolve, tag, aggregate, summarize
  stage          String
  /// Tells repeated stages in one run apart (the mention index for resolve and tag).
  key            String             @default("")
  status         engine_step_status @default(running)
  input          Json?
  output         Json?
  agentVersionId String?            @map("agent_version_id") @db.VarChar(36)
  model          String?
  tokensIn       Int                @default(0) @map("tokens_in")
  tokensOut      Int                @default(0) @map("tokens_out")
  tokensCached   Int                @default(0) @map("tokens_cached")
  costUsd        Float              @default(0) @map("cost_usd")
  latencyMs      Int?               @map("latency_ms")
  error          String?
  attempt        Int                @default(1)
  startedAt      DateTime           @default(now()) @map("started_at") @db.Timestamp(6)
  finishedAt     DateTime?          @map("finished_at") @db.Timestamp(6)
  run            EngineRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  agentVersion   AgentVersion?      @relation(fields: [agentVersionId], references: [id], onDelete: SetNull)

  @@unique([runId, stage, key])
  @@index([agentVersionId, startedAt(sort: Desc)])
  @@index([stage, startedAt(sort: Desc)])
  @@map("engine_steps")
}

/// A pipeline stage that calls a model: read, resolve, tag, summarize.
model Agent {
  key             String         @id
  name            String
  description     String?
  activeVersionId String?        @unique @map("active_version_id") @db.VarChar(36)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  activeVersion   AgentVersion?  @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions        AgentVersion[] @relation("AgentVersions")

  @@map("agents")
}

/// A versioned prompt + model settings. The database is the source of truth
/// after the v1 seed; output schemas stay in code.
model AgentVersion {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  agentKey     String               @map("agent_key")
  version      Int
  systemPrompt String               @map("system_prompt")
  model        String
  effort       String?
  maxTokens    Int                  @map("max_tokens")
  notes        String?
  status       agent_version_status @default(draft)
  evalSummary  Json?                @map("eval_summary")
  createdBy    String?              @map("created_by")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  agent        Agent                @relation("AgentVersions", fields: [agentKey], references: [key], onDelete: Cascade)
  activeFor    Agent?               @relation("ActiveVersion")
  steps        EngineStep[]

  @@unique([agentKey, version])
  @@map("agent_versions")
}

/// A human-approved input and output: few-shots for prompts, later evals.
model Example {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  agentKey    String         @map("agent_key")
  postId      String?        @map("post_id") @db.VarChar(36)
  reviewId    String?        @map("review_id") @db.VarChar(36)
  input       Json
  expected    Json
  source      example_source
  inGoldenSet Boolean        @default(false) @map("in_golden_set")
  note        String?
  createdBy   String?        @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([agentKey, createdAt(sort: Desc)])
  @@index([postId])
  @@map("examples")
}

/// A result waiting for a human decision.
model ReviewItem {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  kind       review_item_kind
  postId     String?            @map("post_id") @db.VarChar(36)
  reviewId   String?            @map("review_id") @db.VarChar(36)
  runId      String?            @map("run_id") @db.VarChar(36)
  question   String
  payload    Json?
  status     review_item_status @default(open)
  resolution Json?
  resolvedBy String?            @map("resolved_by")
  resolvedAt DateTime?          @map("resolved_at") @db.Timestamp(6)
  priority   Int                @default(0)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  post       IngestedPost?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  review     Review?            @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([status, kind, createdAt(sort: Desc)])
  @@index([postId])
  @@map("review_items")
}

/// A tag the Tag agent wished the taxonomy had, merged by normalized label.
model TagSuggestion {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  label           String
  normalizedLabel String                @unique @map("normalized_label")
  categorySlug    String?               @map("category_slug")
  /// [{ quote, postId, reviewId }]
  evidence        Json                  @default("[]")
  count           Int                   @default(1)
  status          tag_suggestion_status @default(open)
  tagId           String?               @map("tag_id") @db.VarChar(36)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("tag_suggestions")
}

/// Area names geocoded once (Resolve biases its search to them).
model GeocodeCache {
  query     String   @id
  lat       Float
  lng       Float
  /// A city, neighborhood or region (not a venue).
  isArea    Boolean? @map("is_area")
  label     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("geocode_cache")
}

/// Google Text Search results, kept a few days so re-running a post doesn't
/// pay Google again (Google allows temporary caching).
model GoogleSearchCache {
  key       String   @id
  query     String
  results   Json
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamp(6)

  @@map("google_search_cache")
}

/// Every admin or agent write to a product entity, written only by the
/// engine's write/ functions (src/lib/engine/write).
model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  /// review, place, source, tag, agent_version, …
  entity       String
  entityId     String   @map("entity_id")
  /// create, update, delete, merge, …
  action       String
  /// { field: { from, to } }
  fieldChanges Json?    @map("field_changes")
  /// A user id, or an agent key (read, resolve, tag, summarize)
  actor        String
  runId        String?  @map("run_id") @db.VarChar(36)
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([entity, entityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
}

